node_modules/
dist/
dist-electron/
release/
build/bin/
# Android gradle project: keep sources + gradle wrapper committed, ignore
# build outputs, gradle caches, machine-local SDK paths and the overlay JSON
# that android:build:go regenerates every run.
build/android/.gradle/
build/android/build/
build/android/app/build/
build/android/app/src/main/jniLibs/
build/android/local.properties
build/android/overlay.json
# Local stable-release-keystore reference + passwords for release builds
# (the keystore file itself lives outside the repo, e.g. D:\Android\keystore;
# CI receives the same material via Actions secrets). Never commit.
build/android/keystore.properties
build/android/captures/
build/windows/installer/*
!build/windows/installer/project.nsi
# Committed installer macro library: CI runs makensis directly on project.nsi
# (no wails CLI regenerates wails_tools.nsh anymore). tmp/ stays ignored.
!build/windows/installer/wails_tools.nsh
/llama-desktop.exe
/llama-gui.exe
.vite/
.task/
*.log
.DS_Store
Thumbs.db
LLM-Models/
llama-cpp/
llama-desktop-config.json
llama-desktop-server-handover.json
llama-desktop-benchcache.json
llama-desktop-docscache/
llama-gui-config.json
myllama-config.json
myllama-server-handover.json
myllama-benchcache.json
myllama-docscache/
.codegraph
.zcode/plans/
.mimosa/

# Transient Windows resource object generated by `wails3 task generate:syso`
# before production go build and deleted right after (icon + manifest embed).
/wails_windows_amd64.syso

# Local staging area for the service-chain e2e assets (pinned llama.cpp
# build + tiny GGUF), mirrored by the CI actions/cache of the same name.
.e2e-cache/

# Local design drafts (Android mockups / branding explorations) are kept on the
# author's machine only, never committed; the dir also holds the tracked icon.png.
docs/branding/*.html

# Playwright-MCP local scratch (browser snapshots, walkthrough screenshots,
# task-package drafts). Never committed.
.playwright-mcp/
